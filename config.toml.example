# Business configuration. Do not put API keys here.

[models]
chat_model = "qwen-plus"
embedding_model = "text-embedding-v3"
embedding_dimensions = 1024

[memory]
auto_retrieve_limit = 5
tool_retrieve_limit = 10
max_injected_tokens = 1200
vector_weight = 0.55
keyword_weight = 0.20
recency_weight = 0.10
importance_weight = 0.10
type_weight = 0.05
recency_half_life_days = 30
min_relevance_score = 0.08
max_retries = 3
active_confidence_threshold = 0.85
pending_confidence_threshold = 0.5

[agent]
recent_turns = 8
max_tool_rounds = 4
context_token_budget = 6000
context_system_reserve_tokens = 200
summary_trigger_tokens = 4800
summary_refresh_messages = 6
summary_max_chars = 1200

[security]
max_input_chars = 4000
secret_redaction_enabled = true
rate_limit_per_minute = 20
daily_token_budget = 20000

[tools]
enabled = true
allowed_builtin_tools = ["builtin.memory.search", "builtin.memory.timeline", "builtin.memory.propose_update"]
default_timeout_seconds = 8.0

[mcp]
enabled = true
allowed_commands = ["python", "node", "npx", "uvx"]

[[mcp.servers]]
id = "filesystem"
enabled = false
transport = "stdio"
command = "npx"
args = ["-y", "@modelcontextprotocol/server-filesystem@2026.8.31", "./demo-workspace"]
env_allowlist = []
# Optional explicit remote-name allowlist; omitted means all discovered tools.
# allowed_tools = ["read_file"]
command_timeout_seconds = 30.0

[mcp.servers.default_permissions]
capabilities = ["filesystem.read"]

[mcp.servers.tool_permissions.write_file]
capabilities = ["filesystem.write"]

[mcp.servers.tool_permissions.edit_file]
capabilities = ["filesystem.write"]

[mcp.servers.tool_permissions.create_directory]
capabilities = ["filesystem.write"]

[mcp.servers.tool_permissions.move_file]
capabilities = ["filesystem.write"]
