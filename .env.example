# Runtime secrets and deployment overrides only.
DASHSCOPE_API_KEY=replace-me
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
POSTGRES_DB=memory_agent
POSTGRES_USER=memory_agent
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql+asyncpg://memory_agent:replace-me@localhost:5432/memory_agent
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional shared password for protected demo deployments. Leave empty locally.
DEMO_SHARED_PASSWORD=
# Local API authentication, independent of demo password and user_key.
# Generate once: python -c "import secrets; print(secrets.token_urlsafe(32))"
LOCAL_API_TOKEN=
# Optional absolute application-data directory. Default: repository/.runtime
# APP_DATA_DIR=F:/memory-agent-data
